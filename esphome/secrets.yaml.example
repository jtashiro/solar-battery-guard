# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"

# Fallback AP password if wifi connection fails (min 8 chars)
ap_password: "changeme123"

# Generate with: esphome generate-key   (or: openssl rand -base64 32)
# solar-battery-guard.yaml (main unit with the shunt + charger control)
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "changeme-ota-password"

# solar_battery_monitor.yaml (separate display-only viewer board) - use a
# DIFFERENT key/password than above, since this is a distinct physical
# device with its own identity
monitor_api_encryption_key: "REPLACE_WITH_ANOTHER_32_BYTE_BASE64_KEY"
monitor_ota_password: "changeme-monitor-ota-password"

# solar_battery_monitor.yaml - polls Home Assistant's REST API directly
# instead of using ESPHome's push-subscription mechanism (which proved
# unreliable - see README). Base URL of your HA instance (no trailing
# slash) and a Long-Lived Access Token generated from your HA profile
# (click your user icon (bottom-left) -> scroll to bottom -> "Long-Lived
# Access Tokens" -> Create Token).
ha_base_url: "http://192.168.1.96:8123"
ha_long_lived_token: "REPLACE_WITH_YOUR_LONG_LIVED_ACCESS_TOKEN"
